# Database
DATABASE_URI=postgresql://kurnik:kurnik@localhost:5432/kurnik_sopa
PAYLOAD_SECRET=your-random-secret-min-32-chars-change-me

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3 / Cloudflare R2 (production media storage)
S3_ENDPOINT=https://...r2.cloudflarestorage.com
S3_BUCKET=kurnik-sopa-media
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# Email (Resend transactional)
# Leave empty in local dev to use Payload's console logger
RESEND_API_KEY=re_...
# Until kurnik-sopa.cz is verified in Resend, use onboarding@resend.dev on previews
EMAIL_FROM=info@kurnik-sopa.cz

# Google Tag Manager container ID (e.g. GTM-XXXXXX). Empty disables GTM/GA loading.
# GA4 is configured INSIDE the GTM container, not as a separate env var.
NEXT_PUBLIC_GTM_ID=

# Direct browser → R2 uploads. Set to "true" only where the origin is listed in
# the R2 bucket CORS policy (localhost, dev.kurnik-sopa.cz, the apex).
# Unset elsewhere: uploads then route through the Next server, which is capped
# at ~4.5 MB per request on Vercel.
ENABLE_CLIENT_UPLOADS=
